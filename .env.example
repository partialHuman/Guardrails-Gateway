# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# REQUIRED. A long random key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GUARDRAILS_API_KEY=

# Interface the published ports bind to.
# 127.0.0.1 = reachable from this machine only (default, safest).
# 0.0.0.0   = reachable from the network: only with a strong API key and a UI password.
GUARDRAILS_BIND_ADDRESS=127.0.0.1

# The Streamlit UI lends the API key to whoever opens it.
# Set a password, or (localhost only) allow anonymous use of the UI.
GUARDRAILS_UI_PASSWORD=
GUARDRAILS_UI_ALLOW_ANONYMOUS=false

# Local development ONLY: let the API run with no authentication at all.
GUARDRAILS_ALLOW_ANONYMOUS=false

# Reverse proxies whose X-Forwarded-For may be trusted: IPs and/or CIDR networks.
# GUARDRAILS_TRUSTED_PROXIES=172.18.0.0/16
GUARDRAILS_TRUSTED_PROXIES=

# Optional explicit environment-file loader (disabled unless explicitly set).
# No automatic .env discovery occurs. Process environment variables always take
# precedence over file values, and an empty or whitespace-only process variable
# resolves to its default rather than falling back to the file.
# GUARDRAILS_ENV_FILE=/path/to/sentraguard.env

# Strict unknown-variable handling (defaults to false).
# When false, unrecognized GUARDRAILS_* keys emit sanitized startup warnings.
# When true, unrecognized GUARDRAILS_* keys fail application startup.
# GUARDRAILS_STRICT_ENV=false
