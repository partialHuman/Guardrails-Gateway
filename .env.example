# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# REQUIRED. A long random key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GUARDRAILS_API_KEY=

# Interface the published ports bind to.
# 127.0.0.1 = reachable from this machine only (default, safest).
# 0.0.0.0   = reachable from the network: only with a strong API key and a UI password.
GUARDRAILS_BIND_ADDRESS=127.0.0.1

# The Streamlit UI lends the API key to whoever opens it.
# Set a password, or (localhost only) allow anonymous use of the UI.
GUARDRAILS_UI_PASSWORD=
GUARDRAILS_UI_ALLOW_ANONYMOUS=false

# Local development ONLY: let the API run with no authentication at all.
GUARDRAILS_ALLOW_ANONYMOUS=false

# Reverse proxies whose X-Forwarded-For may be trusted: IPs and/or CIDR networks.
# GUARDRAILS_TRUSTED_PROXIES=172.18.0.0/16
GUARDRAILS_TRUSTED_PROXIES=
