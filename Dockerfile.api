FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Secure by default: a container refuses to start without GUARDRAILS_API_KEY.
    # Opt in to unauthenticated use explicitly with GUARDRAILS_ALLOW_ANONYMOUS=true.
    GUARDRAILS_ALLOW_ANONYMOUS=false

WORKDIR /app

# Run as unprivileged non-root user for container security
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -s /sbin/nologin -M appuser

COPY requirements.api.txt .

RUN pip install --no-cache-dir -r requirements.api.txt

# Application code stays root-owned and read-only for the runtime user.
COPY app ./app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health').status == 200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header"]
